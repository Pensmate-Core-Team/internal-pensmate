  "components": [
    {
      "name": "Tombol primary",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Tindakan utama.",
      "html": "<button class=\"ds-button-primary\" type=\"button\">Buat draf</button>",
      "css": ".ds-button-primary{font-family:'Instrument Sans', ui-sans-serif, system-ui, sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 16px;border:1px solid transparent;border-radius:8px;font-size:14px;line-height:20px;font-weight:600;background:var(--accent,#246344);color:#fff;cursor:pointer;transition:background-color 160ms,transform 160ms;}.ds-button-primary:hover{background:#194b32;transform:translateY(-1px);}.ds-button-primary:active{transform:translateY(1px);}.ds-button-primary:focus-visible{outline:2px solid var(--accent,#246344);outline-offset:4px;}.ds-button-primary:disabled{opacity:.6;cursor:wait;}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none;}}"
    },
    {
      "name": "Tombol secondary",
      "kind": "button",
      "description": "Tindakan pendamping.",
      "html": "<button class=\"ds-button-secondary\" type=\"button\">Simpan referensi</button>",
      "css": ".ds-button-secondary{font-family:'Instrument Sans', ui-sans-serif, system-ui, sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 16px;border:1px solid #cfd6cd;border-radius:8px;font-size:14px;line-height:20px;font-weight:600;background:#fff;color:#34453a;cursor:pointer;transition:background-color 160ms,transform 160ms;}.ds-button-secondary:hover{background:#edf1e9;transform:translateY(-1px);}.ds-button-secondary:active{transform:translateY(1px);}.ds-button-secondary:focus-visible{outline:2px solid var(--accent,#246344);outline-offset:4px;}.ds-button-secondary:disabled{opacity:.6;cursor:wait;}@media(prefers-reduced-motion:reduce){.ds-button-secondary{transition:none;}}"
    },
    {
      "name": "Bidang isian",
      "kind": "input",
      "refersTo": "field",
      "description": "Label, isian, dan kesalahan yang terhubung.",
      "html": "<div class=\"ds-field\"><label for=\"ds-title\">Judul konten</label><input id=\"ds-title\" value=\"Ide konten mingguan\" aria-describedby=\"ds-hint\"><p id=\"ds-hint\">Gunakan judul yang mudah dikenali tim.</p></div>",
      "css": ".ds-field{font-family:'Instrument Sans', ui-sans-serif, system-ui, sans-serif;color:var(--ink,#202a24);}.ds-field label{display:block;margin-bottom:8px;font-size:14px;line-height:20px;font-weight:500;}.ds-field input{box-sizing:border-box;width:100%;min-height:46px;padding:0 12px;border:1px solid #cbd2c9;border-radius:8px;font:inherit;background:#fff;color:var(--ink,#202a24);caret-color:var(--accent,#246344);}.ds-field input:focus-visible{outline:2px solid var(--accent,#246344);outline-offset:4px;}.ds-field input[aria-invalid=\"true\"]{border-color:#b23f36;}.ds-field p{margin:8px 0 0;font-size:12px;line-height:1.625;color:var(--muted,#647067);}"
    },
    {
      "name": "Navigasi aktif",
      "kind": "nav",
      "description": "Tujuan aktif pada sidebar.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Navigasi utama\"><a href=\"#konten\" aria-current=\"page\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\"><rect x=\"4\" y=\"4\" width=\"6\" height=\"6\" rx=\"1\"/><rect x=\"14\" y=\"4\" width=\"6\" height=\"6\" rx=\"1\"/><rect x=\"4\" y=\"14\" width=\"6\" height=\"6\" rx=\"1\"/><rect x=\"14\" y=\"14\" width=\"6\" height=\"6\" rx=\"1\"/></svg>Draf konten</a></nav>",
      "css": ".ds-nav{font-family:'Instrument Sans', ui-sans-serif, system-ui, sans-serif;padding:12px;background:#f0f2eb;}.ds-nav a{display:flex;align-items:center;gap:12px;min-height:48px;padding:0 12px;border-radius:8px;text-decoration:none;font-size:14px;font-weight:500;background:#dce8d3;color:#224e31;transition:background-color 150ms;}.ds-nav a:hover{background:#e4e9de;}.ds-nav a:focus-visible{outline:2px solid var(--accent,#246344);outline-offset:4px;}.ds-nav svg{width:20px;height:20px;flex-shrink:0;}@media(prefers-reduced-motion:reduce){.ds-nav a{transition:none;}}"
