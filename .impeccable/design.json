      "css": ".ds-panel{font-family:'Instrument Sans', ui-sans-serif, system-ui, sans-serif;min-width:0;padding:28px;border:1px solid var(--line,#dfe4dd);border-radius:12px;background:#fff;color:var(--ink,#202a24);}.ds-panel h2{margin:0 0 24px;font-size:18px;font-weight:600;line-height:1.375;letter-spacing:-.015em;}.ds-panel dl{margin:0;}.ds-panel dt{margin-bottom:8px;font-size:12px;color:var(--muted,#647067);}.ds-panel dd{margin:0 0 24px;font-size:14px;line-height:20px;font-weight:500;overflow-wrap:anywhere;}.ds-panel dd:last-child{margin-bottom:0;}@media(max-width:767px){.ds-panel{padding:24px 20px;}}"
